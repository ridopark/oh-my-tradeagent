# LOCAL-DEV environment overrides — copy to infra/.env.local (gitignored) and fill in.
#
#   cp infra/.env.local.example infra/.env.local   # then edit
#
# These keep your LOCAL runs ISOLATED from production: a SEPARATE Alpaca paper account and SEPARATE
# Discord read/output channels, so nothing here ever touches prod's account or posts to prod's
# channels. NEVER put production credentials in this file. Consumed by:
#   - docker compose --env-file infra/.env.local -f infra/docker-compose.yml ...   (the signal-source
#     sidecar reads DISCORD_CHANNEL_URL / TENANT_ID / STRATEGY_ID), and
#   - the Java services when run locally via `mvn` (export these, or `set -a; . infra/.env.local; set +a`).
# See docs/ops/local-dev.md.

# --- Alpaca account (exec-svc + market-data) — a DEDICATED local paper account, not prod's ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# exec-svc DB — REQUIRED (no default; exec fails fast without it). Local paper order journal:
EXEC_DB_URL=jdbc:postgresql://localhost:5432/exec_alpaca_paper

# --- Discord READ channel (signal-source-discord input) — a TEST channel you control ---
# Must be a CHANNEL url (https://discord.com/channels/<guild>/<channel>), NOT a webhook url — the
# scraper opens the channel page in a browser. (ALERT_DISCORD_WEBHOOK_URL below IS a webhook.)
DISCORD_CHANNEL_URL=
TENANT_ID=dev
STRATEGY_ID=copytrade-v1

# --- Discord OUTPUT channel (orchestrator + exec post outcomes/alerts) — a TEST webhook ---
ALERT_DISCORD_WEBHOOK_URL=

# --- Full-pipeline runtime flags (without these the pipeline silently no-ops) ---
# Place REAL orders on the local Alpaca PAPER account; the default 'stub' is in-memory (no broker call).
BROKER_IMPL=alpaca-paper
# Mirror the full signal feed (received + accepted/rejected) to ALERT_DISCORD_WEBHOOK_URL; default off.
ALERT_SIGNAL_FEED_ENABLED=true
# Ingest broker fills so a BTO fill opens a PositionWorkflow (Positions/Portfolio populate).
EXEC_FILL_LISTENER_ENABLED=true
EXEC_FILL_LISTENER_POLL_ENABLED=true

# --- Local service DB auth (override the prod least-privilege runtime roles) ---
# In prod each writer connects as a restricted role whose password the operator sets out of band.
# Locally those roles either don't exist or were created by Flyway with a placeholder password, so
# the app defaults won't authenticate — use the superuser `temporal` locally instead. (exec already
# defaults EXEC_DB_USER/PASS to temporal, so no override needed there.)
ORCHESTRATOR_DB_USER=temporal
ORCHESTRATOR_DB_PASS=temporal
# The BFF's Flyway creates dashboard_readonly with this; the Next.js app connects with it. REQUIRED
# (no default). Must equal DASHBOARD_READONLY_PASSWORD in dashboard/.env.local.
DASHBOARD_READONLY_PASSWORD=dashboard_readonly_dev
