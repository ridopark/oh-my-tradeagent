# LOCAL-DEV environment overrides — copy to infra/.env.local (gitignored) and fill in.
#
#   cp infra/.env.local.example infra/.env.local   # then edit
#
# These keep your LOCAL runs ISOLATED from production: a SEPARATE Alpaca paper account and SEPARATE
# Discord read/output channels, so nothing here ever touches prod's account or posts to prod's
# channels. NEVER put production credentials in this file. Consumed by:
#   - docker compose --env-file infra/.env.local -f infra/docker-compose.yml ...   (the signal-source
#     sidecar reads DISCORD_CHANNEL_URL / TENANT_ID / STRATEGY_ID), and
#   - the Java services when run locally via `mvn` (export these, or `set -a; . infra/.env.local; set +a`).
# See docs/ops/local-dev.md.

# --- Alpaca account (exec-svc + market-data) — a DEDICATED local paper account, not prod's ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# exec-svc DB — REQUIRED (no default; exec fails fast without it). Local paper order journal:
EXEC_DB_URL=jdbc:postgresql://localhost:5432/exec_alpaca_paper

# --- Discord READ channel (signal-source-discord input) — a TEST channel you control ---
DISCORD_CHANNEL_URL=
TENANT_ID=dev
STRATEGY_ID=copytrade-v1

# --- Discord OUTPUT channel (orchestrator + exec post outcomes/alerts) — a TEST webhook ---
ALERT_DISCORD_WEBHOOK_URL=
