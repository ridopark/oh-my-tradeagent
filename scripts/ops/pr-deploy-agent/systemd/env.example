# pr-deploy-agent env file
# Copy to ~/.config/pr-deploy-agent/env and edit.
# Lines starting with # are ignored.  Values must not be shell-quoted.

# GitHub repo slug (default: ridopark/oh-my-tradeagent)
# REPO=ridopark/oh-my-tradeagent

# SSH target for homelab live-state reads (default: ridopark@192.168.10.123)
# HOMELAB_SSH=ridopark@192.168.10.123

# Deploy-gate mode: recommend (log + Discord only) or act (approve waiting runs)
# Step 1 default: recommend.  Flip to act after watching a few recommend cycles.
DEPLOY_MODE=recommend

# PR-duty mode: recommend (log + Discord only) or act (merge, fix, label)
# Step 3 default: recommend.  Flip independently of DEPLOY_MODE.
PR_MODE=recommend

# Override the runtime state directory if needed.
# STATE_DIR=/home/youruser/.local/state/pr-deploy-agent

# Discord webhook URL.  The agent falls back to the repo .env if unset.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
