<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0                              http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ohmytradeagent</groupId>
    <artifactId>oh-my-tradeagent-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>orchestrator-svc</artifactId>
  <name>oh-my-tradeagent orchestrator-svc</name>
  <description>Phase 2a: Spring Boot + Temporal worker that hosts CopytradeSignalWorkflow with in-process risk + contract-resolver Activities on the orchestrator-core task queue. No broker placement yet (Phase 2b).</description>

  <dependencies>
    <dependency>
      <groupId>com.ohmytradeagent</groupId>
      <artifactId>contract-java</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jooq</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Provides JacksonAutoConfiguration's @Bean ObjectMapper, required by
         AuditActivitiesImpl. The orchestrator-svc has no web stack, so we add the json
         starter directly rather than pulling in spring-boot-starter-web. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-sdk</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Issue #285: TEST-ONLY. AdoptionWorkflowIT registers the REAL exec broker-truth Activity
      (ReconciliationExecActivityImpl + JooqOrderIntentJournal + StubBroker, all in exec-svc/src/main)
      on the broker-alpaca-paper task queue to prove the adoption path reaches real broker truth +
      a real journal over the exec task queue (the throwing placeholder is gone). This is a
      test-scope reuse of exec's fixtures only — production keeps orchestrator and exec decoupled
      across the Temporal task-queue boundary (no in-process exec injection).
    -->
    <dependency>
      <groupId>com.ohmytradeagent</groupId>
      <artifactId>exec-svc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Orchestrator is the long-pole test module (118 test classes, Temporal-heavy) and it
            gets FASTER with LESS parallelism, not more. TestWorkflowEnvironment's virtual-clock
            time-skipping only engages while the JVM is quiescent; give the suite real parallelism
            and something is always runnable, so workflow timers stop being skipped and degrade
            into REAL-time waits. Measured on the full suite (1420 tests, 2026-08-22):

              1 core,  forkCount=1  ->  84s / 98s / 99s  (3 runs, 0 failures)   <- this config
              2 cores, forkCount=1  -> 122s
              2 cores, forkCount=2  -> 117s
              4 cores, forkCount=2  -> 116s, 149s                               <- the old config
              4 cores, forkCount=4  -> 151s
              4 cores, forkCount=6  -> 148s

            forkCount 2 -> 4 -> 6 is FLAT (149/151/148s): raising it is not a speed fix, it has
            been measured. The controlled comparison is the forkCount=1 pair — one JVM, 1 core 84s
            vs 2 cores 122s. So: ONE fork, and the CI workflow pins this module's `mvn verify` to
            a single cpu with `taskset -c 0` — forkCount=1 alone is only half the fix, because one
            JVM with 4 cores is 122s, no better than the old config.

            A surefire <jvm> wrapper was tried first so the pinning would travel with the pom;
            surefire re-derives the JDK path from <jvm> and does not honour a wrapper's affinity
            call (the forked JVM came back with the full cpu set). Keep the pinning in ci.yml.

            The same degradation is what stretches PositionWorkflowImplTest's wait helpers from
            <0.5s to >25s on a loaded runner, which is where its CI flakes come from.
          -->
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <!--
            Backstop for a hang that the per-test timeout CANNOT see: one inside @BeforeAll, a
            static initialiser, or fork startup, where there is no test method to attribute the
            timeout to. src/test/resources/junit-platform.properties covers the common case (60s
            per test method, named in the failure); this covers the rest by killing the fork.
            900s is ~3x the module's whole ~4-5min suite, so it only fires on a genuine wedge.
          -->
          <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <classifier>boot</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!--
            Run the Testcontainers-backed ITs (10 Postgres + 1 Redis) in 2 forked JVMs to
            roughly halve the IT phase wall-clock. Each fork is a separate PROCESS, and every
            IT still uses its own @Container (random host port, own DB/role state), so test
            isolation is fully preserved — this parallelizes container startup WITHOUT the
            cross-test data-bleed risk of a shared/singleton container. Caps at 2 concurrent
            Postgres containers, comfortable on a CI runner. Validated by CI (this repo's ITs
            require a real Docker daemon, which the Docker-Desktop-on-WSL2 dev socket can't
            provide, so local `mvn verify` skips them).
          -->
          <forkCount>2</forkCount>
          <reuseForks>true</reuseForks>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
