# Auth.js
AUTH_SECRET=generate-with-`openssl rand -base64 32`
# Over http://localhost dev this is fine; production MUST be https:// (see TLS note in the plan).
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Identity -> tenant lookup (the `dashboard` Postgres DB the BFF owns).
DASHBOARD_DATABASE_URL=postgres://temporal:temporal@localhost:5432/dashboard

# Off-ingress BFF (in-cluster URL in prod; localhost for dev).
BFF_INTERNAL_URL=http://localhost:8083
BFF_SHARED_TOKEN=dev-shared-token
