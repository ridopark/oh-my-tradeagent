# Auth.js
AUTH_SECRET=generate-with-`openssl rand -base64 32`
# Over http://localhost dev this is fine; production MUST be https:// (see TLS note in the plan).
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# LOCAL DEV ONLY: enable the passwordless "Dev login" button so you don't need Google/Facebook.
# Double-gated (also requires NODE_ENV === development, which `next dev` sets) — NEVER set this in a
# prod deploy. AUTH_DEV_TENANT is the tenant the dev login maps to (must exist under tenants/).
AUTH_DEV_LOGIN=true
AUTH_DEV_TENANT=dev

# Identity -> tenant lookup (the `dashboard` Postgres DB the BFF owns). The app only SELECTs from
# dashboard_user as the SELECT-only `dashboard_readonly` role. DASHBOARD_READONLY_PASSWORD must match
# the BFF's value (its Flyway creates the role with it) — single source, no connection URL to sync.
DASHBOARD_DB_HOST=localhost
DASHBOARD_DB_PORT=5432
DASHBOARD_DB_NAME=dashboard
DASHBOARD_DB_USER=dashboard_readonly
DASHBOARD_READONLY_PASSWORD=dashboard_readonly_dev

# Off-ingress BFF (in-cluster URL in prod; localhost for dev).
BFF_INTERNAL_URL=http://localhost:8083
BFF_SHARED_TOKEN=dev-shared-token

# api-gateway broker-credential WRITE endpoint (UI-P2-b). Server-only — never NEXT_PUBLIC_*.
# API_GATEWAY_SHARED_TOKEN must equal api-gateway's own API_GATEWAY_SHARED_TOKEN.
API_GATEWAY_BASE_URL=http://localhost:8082
API_GATEWAY_SHARED_TOKEN=dev-shared-token
# Dark-by-default: leave unset/false to show the broker-credential STATUS panel only. Set to "true"
# to enable the write form (the api-gateway route is itself dark until its own flag is on).
BROKER_CREDENTIALS_WRITE_ENABLED=false

# Operator admin pages (I-2). Comma-separated allowlist of operator emails: an authenticated identity
# whose email is listed becomes an operator (session.isOperator) and sees the /admin/* pages. Empty/
# unset => nobody is an operator. The matched email is sent as X-Operator-Id to the admin BFF/
# api-gateway routes (which are themselves dark-gated server-side).
OPERATOR_EMAILS=
# Dark-by-default: leave unset/false to render the operator tenant list READ-ONLY (no activate/
# deactivate). Set to "true" to enable the buttons (the api-gateway activation route is itself dark
# until operator.activation.enabled is on). Activation arms REAL money — keep off until Phase E.
OPERATOR_ACTIVATION_ENABLED=false
# Onboarding form (/admin/onboard) step gates, dark-by-default. Each mirrors an api-gateway route
# flag and renders its step read-only when unset/false. Even when "true" the api-gateway route is
# itself dark (404s) until its own flag is on. Paper-only this phase — keys for live targets are
# refused by exec until Phase E.
OPERATOR_TENANT_CREATE_ENABLED=false
OPERATOR_CREDENTIAL_WRITE_ENABLED=false
